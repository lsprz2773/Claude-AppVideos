# Copia este archivo a .env y completa los valores. .env no se versiona.
APP_URL=http://localhost:3000
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Solo Windows: ruta a whisper-cli.exe para los subtítulos por palabra (ver docs/instalacion.md).
# Ejemplo: C:\Users\<tu-usuario>\.cache\whisper-cpp\bin\Release\whisper-cli.exe
HYPERFRAMES_WHISPER_PATH=
