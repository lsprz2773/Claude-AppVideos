# Copia este archivo a .env y completa los valores. .env no se versiona.
APP_URL=http://localhost:3000
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Solo Windows y solo si whisper-cli.exe no está en la carpeta estándar
# (%USERPROFILE%\.cache\whisper-cpp\bin\Release\whisper-cli.exe). Ver docs/instalacion.md.
HYPERFRAMES_WHISPER_PATH=
